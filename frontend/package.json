{
  "name": "local-meeting-analyzer",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "version": "1.6.2",
  "description": "Grabación y análisis de reuniones 100% local con IA",
  "author": "Local Meeting Analyzer",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && electron .",
    "build": "vite build",
    "electron:build": "npm run build && electron-builder",
    "build:backend": "node ../scripts/build-backend.js",
    "dist:win": "npm run build:backend && npm run build && electron-builder --win --x64 --publish never",
    "dist:nsis": "npm run build && electron-builder --win nsis --x64 --publish never",
    "lint": "oxlint",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "axios": "^1.18.1",
    "electron-updater": "^6.8.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^10.0.3",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.1.2",
    "oxlint": "^1.69.0",
    "vite": "^8.1.0",
    "vitest": "^5.0.3",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.local.meeting-analyzer",
    "productName": "Local Meeting Analyzer",
    "directories": {
      "output": "dist-electron",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/meeting-backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../bin/ffmpeg.exe",
        "to": "bin/ffmpeg.exe"
      },
      {
        "from": "../legal/PRIVACY.md",
        "to": "docs/PRIVACY.md"
      },
      {
        "from": "../legal/EULA.txt",
        "to": "docs/EULA.txt"
      },
      {
        "from": "../legal/CONSENT_NOTICE.md",
        "to": "docs/CONSENT_NOTICE.md"
      },
      {
        "from": "../THIRD_PARTY_NOTICES.md",
        "to": "docs/THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "../CHANGELOG.md",
        "to": "docs/CHANGELOG.md"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "appx",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Local Meeting Analyzer",
      "license": "../legal/EULA.txt",
      "multiLanguageInstaller": false,
      "language": "3082",
      "deleteAppDataOnUninstall": false,
      "artifactName": "LocalMeetingAnalyzer-Setup-${version}.${ext}"
    },
    "appx": {
      "identityName": "REEMPLAZAR.PartnerCenter.PackageIdentityName",
      "publisher": "CN=REEMPLAZAR-PartnerCenter-PackageIdentityPublisher",
      "publisherDisplayName": "REEMPLAZAR con PublisherDisplayName de Partner Center",
      "applicationId": "LocalMeetingAnalyzer",
      "displayName": "Local Meeting Analyzer",
      "backgroundColor": "#171625",
      "languages": [
        "es-ES"
      ],
      "capabilities": [
        "runFullTrust",
        "internetClient",
        "microphone"
      ],
      "minVersion": "10.0.17763.0",
      "maxVersionTested": "10.0.26100.0",
      "artifactName": "LocalMeetingAnalyzer-${version}-${arch}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "edixon-javier",
      "repo": "local-meeting-analyzer",
      "releaseType": "draft"
    }
  }
}
